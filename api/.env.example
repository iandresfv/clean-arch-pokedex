# ---------------------------------------------------------------------------
# Pokedex API — environment template
#
# Every variable below is optional in development: the defaults shown are the
# ones the server falls back to. In production (APP_ENV=production) DB_PASSWORD
# becomes mandatory and CORS_ALLOWED_ORIGINS may not contain loopback origins.
# ---------------------------------------------------------------------------

# development | production
APP_ENV=development

# --- Server ----------------------------------------------------------------
# Use 0.0.0.0 inside a container so the port is reachable from the host.
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
# Grace period for in-flight requests when SIGTERM arrives.
SERVER_SHUTDOWN_TIMEOUT=10s
# Per-request ceiling enforced by http.TimeoutHandler.
SERVER_HANDLER_TIMEOUT=10s
SERVER_MAX_HEADER_BYTES=1048576

# --- Database --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pokedex
# disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=disable
# replicas * DB_MAX_CONNS must stay below the server's max_connections (100).
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=30s
DB_STATEMENT_TIMEOUT=10s

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=json

# --- CORS ------------------------------------------------------------------
# Comma-separated. "*" is rejected while CORS_ALLOW_CREDENTIALS=true because
# browsers refuse that combination.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=12h

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=30
# CIDR ranges whose X-Forwarded-For header is trusted. Leave empty when the API
# is exposed directly: the header is client-supplied and trivially spoofed.
TRUSTED_PROXIES=

# --- TLS -------------------------------------------------------------------
# Enabling TLS also enables HTTP/2 via ALPN, with no further configuration.
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- Redis (Phase 12) ------------------------------------------------------
# Required only when running more than one replica: the in-process rate limiter
# and cache hold state that replicas cannot share.
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Response cache --------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL=5m
CACHE_MAX_ENTRIES=1024

{
  "extends": "./tsconfig.app.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["src/main.tsx"],
  "compilerOptions": {
    "composite": true,
    // vite/client must be repeated here: "types" replaces the inherited list
    // rather than extending it, and without it import.meta.env is untyped in
    // every file this project compiles.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  }
}

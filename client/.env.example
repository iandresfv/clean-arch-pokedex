# Base URL of the Pokedex API (the Go backend in ../api).
VITE_API_URL=http://localhost:8080

# Which repository adapter the composition root wires:
#   pokedex-api  this project's own Go API (default)
#   pokeapi      the public PokeAPI, kept as a fallback
# Both implement the same PokemonRepository port, so nothing above the
# infrastructure layer is affected by this choice.
VITE_DATA_SOURCE=pokedex-api

# Per-request timeout in milliseconds.
VITE_REQUEST_TIMEOUT_MS=10000
